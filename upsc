                <div className="pt-4 border-t border-slate-800 flex flex-col items-center gap-2 text-center text-xs text-slate-500">
                  <div>
                    Default Credentials: Username <span className="text-indigo-400 font-mono">x7ansh</span> | Password <span className="text-amber-400 font-mono">727830</span>
                  </div>
