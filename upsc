                      className="px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs flex items-center gap-2 transition self-start"
                    >
                      <Icon name="plus" className="w-4 h-4" />
                      Log +30m Study Session
                    </button>
                  </div>

                  <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {peers.map((peer) => (
                      <div
                        key={peer.id}
                        className={`p-4 rounded-2xl border flex items-center justify-between ${
                          peer.id === 'p4'
                            ? 'bg-indigo-500/5 border-indigo-500/40'
                            : 'bg-slate-50 dark:bg-slate-800/50 border-slate-200 dark:border-slate-800'
                        }`}
                      >
                        <div className="space-y-1">
                          <div className="flex items-center gap-2">
                            <span className="font-bold text-sm">{peer.name}</span>
                            <span className="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-slate-200 dark:bg-slate-700">
                              {peer.role}
                            </span>
                          </div>
                          <p className="text-xs text-slate-500 dark:text-slate-400">{peer.status}</p>
                          <p className="text-[11px] font-semibold text-amber-500">
                            🔥 {peer.streak} Day Consistency Streak
                          </p>
                        </div>
                        <div className="text-right">
                          <span className="text-2xl font-extrabold font-mono text-indigo-600 dark:text-indigo-400">
                            {peer.hoursToday}h
                          </span>
                          <span className="block text-[10px] uppercase text-slate-400">Logged Today</span>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}

            </main>
          </div>
        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
