          <div className="min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 font-sans transition-colors duration-200">
            
            {/* Toast Notification */}
            {notification && (
              <div className="fixed bottom-5 right-5 z-50 flex items-center gap-2 bg-indigo-600 text-white px-4 py-3 rounded-xl shadow-xl border border-indigo-400/30 animate-bounce">
                <Icon name="check" className="w-4 h-4" />
                <span className="text-sm font-medium">{notification}</span>
              </div>
            )}

            {/* Top Navigation Command Bar */}
            <header className="sticky top-0 z-30 border-b border-slate-200 dark:border-slate-800 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md">
              <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
                <div className="flex items-center gap-3">
                  <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-600 to-amber-500 flex items-center justify-center text-white font-bold shadow-md">
                    <Icon name="award" className="w-6 h-6" />
                  </div>
                  <div>
                    <div className="flex items-center gap-2">
                      <h1 className="text-lg font-extrabold tracking-tight bg-gradient-to-r from-indigo-600 to-amber-500 bg-clip-text text-transparent">
                        UPSC 360°
                      </h1>
                      <span className="text-[11px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
                        CSE Command Centre
                      </span>
                    </div>
                    <p className="text-xs text-slate-500 dark:text-slate-400 hidden sm:block">
                      Prelims • GS Mains • {selectedOptional.split(' ')[0]} Optional • Notes Vault
