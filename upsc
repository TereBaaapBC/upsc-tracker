      // Computed Analytics
      const syllabusProgress = useMemo(() => {
        const maxScore = syllabus.length * 4;
        if (maxScore === 0) return 0;
        const currentScore = syllabus.reduce((acc, item) => acc + item.stage, 0);
        return Math.round((currentScore / maxScore) * 100);
      }, [syllabus]);

      const currentOptionalTopics = useMemo(
        () => optionalData[selectedOptional] || [],
        [optionalData, selectedOptional]
      );

      const optionalProgress = useMemo(() => {
        const maxScore = currentOptionalTopics.length * 4;
        if (maxScore === 0) return 0;
        const currentScore = currentOptionalTopics.reduce((acc, item) => acc + item.stage, 0);
        return Math.round((currentScore / maxScore) * 100);
      }, [currentOptionalTopics]);

      const completedTasksCount = tasks.filter((t) => t.completed).length;

      const uploadedFilesCount = useMemo(
        () => notes.filter((n) => Boolean(n.fileAttachment)).length,
        [notes]
      );

      const calcPrelimsScore = (correct, incorrect) => {
        const pos = Number(correct) * 2;
        const neg = Number(incorrect) * (2 / 3);
        return (pos - neg).toFixed(2);
      };

      const liveCalcScore = calcPrelimsScore(mockForm.correct, mockForm.incorrect);
      const liveUnattempted = Math.max(0, 100 - (Number(mockForm.correct) + Number(mockForm.incorrect)));

      // Handlers
      const cycleTopicStage = (id) => {
        setSyllabus((prev) =>
          prev.map((item) =>
            item.id === id ? { ...item, stage: (item.stage + 1) % 5 } : item
          )
