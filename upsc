        setNewOptionalTopic({ paper: 'Paper-I', section: '', topic: '' });
        showToast('Custom Optional micro-topic added at 0%!');
      };

      const handleAddThinker = (e) => {
        e.preventDefault();
        if (!newThinker.scholar.trim() || !newThinker.quote.trim()) return;
        setOptionalThinkers([
          {
            id: 'th_' + Date.now(),
            scholar: newThinker.scholar.trim(),
            quote: newThinker.quote.trim(),
            paper: newThinker.paper
