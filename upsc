        return () => clearTimeout(timer);
      }, [
        isHydrated,
        darkMode,
        syllabus,
        selectedOptional,
        optionalData,
        optionalThinkers,
        tasks,
        notes,
        mocks,
        peers
      ]);

      // Export & Import JSON Backup Handlers
      const handleExportBackup = () => {
        const backupObject = {
          darkMode,
          syllabus,
          selectedOptional,
          optionalData,
          optionalThinkers,
          tasks,
          notes,
          mocks,
          peers,
          exportedAt: new Date().toISOString()
        };
        const blob = new Blob([JSON.stringify(backupObject, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `upsc_360_backup_${new Date().toISOString().slice(0, 10)}.json`;
        a.click();
        URL.revokeObjectURL(url);
        showToast('Backup file downloaded to your device!');
      };

      const handleImportBackup = (e) => {
        const file = e.target.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (ev) => {
          try {
            const parsed = JSON.parse(String(ev.target?.result || '{}'));
            if (parsed.syllabus) setSyllabus(parsed.syllabus);
            if (parsed.selectedOptional) setSelectedOptional(parsed.selectedOptional);
            if (parsed.optionalData) setOptionalData(parsed.optionalData);
            if (parsed.optionalThinkers) setOptionalThinkers(parsed.optionalThinkers);
            if (parsed.tasks) setTasks(parsed.tasks);
            if (parsed.notes) setNotes(parsed.notes);
            if (parsed.mocks) setMocks(parsed.mocks);
            if (parsed.peers) setPeers(parsed.peers);
            showToast('Backup restored and synced to vault!');
          } catch (err) {
            showToast('Invalid backup JSON file.');
          }
        };
        reader.readAsText(file);
        e.target.value = '';
      };

      // Timer Effect
      useEffect(() => {
        let interval = null;
        if (timerRunning && timerSeconds > 0) {
          interval = setInterval(() => {
            setTimerSeconds((prev) => prev - 1);
          }, 1000);
        } else if (timerSeconds === 0 && timerRunning) {
          setTimerRunning(false);
          showToast('Study Sprint Complete! Take a 10-minute breather.');
        }
        return () => clearInterval(interval);
      }, [timerRunning, timerSeconds]);

      const formatTime = (totalSeconds) => {
        const mins = Math.floor(totalSeconds / 60);
        const secs = totalSeconds % 60;
        return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
      };

      const setPresetTimer = (mins, label) => {
        setTimerRunning(false);
        setTimerSeconds(mins * 60);
        setTimerMode(label);
