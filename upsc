      const deleteTask = (id) => {
        setTasks((prev) => prev.filter((t) => t.id !== id));
      };

      const processUploadedFiles = (fileList) => {
        if (!fileList || fileList.length === 0) return;
        const filesArray = Array.from(fileList);

        filesArray.forEach((file) => {
          const sizeKB = (file.size / 1024).toFixed(1);
          const ext = file.name.split('.').pop()?.toUpperCase() || 'FILE';

          const createNoteEntry = (contentSnippet, persistentUrl) => {
            const newUploadedNote = {
              id: 'up_' + Date.now() + Math.random().toString(36).slice(2, 6),
              title: file.name.replace(/\.[^/.]+$/, ''),
              category: uploadCategory,
              subFolder: uploadSubFolder || 'Uploaded Files',
              source: `Uploaded ${ext} (${sizeKB} KB)`,
              date: new Date().toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }),
              content: contentSnippet,
              keywords: [ext, uploadCategory.split(' ')[0], uploadSubFolder || 'Notes'],
              fileAttachment: {
                name: file.name,
                size: `${sizeKB} KB`,
                type: ext,
                url: persistentUrl
              }
            };
            setNotes((prev) => [newUploadedNote, ...prev]);
          };

          if (
            file.type.startsWith('text/') ||
            file.name.endsWith('.md') ||
            file.name.endsWith('.txt') ||
            file.name.endsWith('.csv')
          ) {
            const reader = new FileReader();
            reader.onload = (ev) => {
              const textSnippet = String(ev.target?.result || '').slice(0, 2000);
              const dataUrl = `data:text/plain;charset=utf-8,${encodeURIComponent(textSnippet)}`;
              createNoteEntry(textSnippet || `Uploaded document: ${file.name}`, dataUrl);
            };
            reader.readAsText(file);
          } else if (file.size <= 150 * 1024) {
            const reader = new FileReader();
            reader.onload = (ev) => {
              const dataUrl = String(ev.target?.result || '');
              createNoteEntry(
                `Categorized file uploaded under "${uploadCategory}" → Folder: "${uploadSubFolder}". Click 'Open / Download File' below to view your saved ${ext} document.`,
                dataUrl
              );
            };
            reader.readAsDataURL(file);
          } else {
            const fileUrl = URL.createObjectURL(file);
            createNoteEntry(
              `Categorized file uploaded under "${uploadCategory}" → Folder: "${uploadSubFolder}" (${sizeKB} KB). File metadata is permanently saved in your vault.`,
              fileUrl
            );
          }
        });

        showToast(`${filesArray.length} file(s) uploaded & saved into "${uploadCategory}"!`);
      };

      const handleFileChange = (e) => {
        processUploadedFiles(e.target.files);
        e.target.value = '';
      };

      const handleDrop = (e) => {
        e.preventDefault();
