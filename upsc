      const cycleOptionalStage = (id) => {
        setOptionalData((prev) => ({
          ...prev,
          [selectedOptional]: (prev[selectedOptional] || []).map((item) =>
            item.id === id ? { ...item, stage: (item.stage + 1) % 5 } : item
          )
        }));
        showToast(`${selectedOptional.split(' ')[0]} Optional topic stage updated!`);
      };

      const resetAllProgressToZero = () => {
        setSyllabus((prev) => prev.map((item) => ({ ...item, stage: 0 })));
        setOptionalData((prev) => {
          const updated = {};
          Object.keys(prev).forEach((key) => {
            updated[key] = prev[key].map((item) => ({ ...item, stage: 0 }));
          });
          return updated;
        });
        setTasks((prev) => prev.map((t) => ({ ...t, completed: false })));
        showToast('All GS, Optional & Task progress reset to 0%!');
      };

      const handleAddOptionalTopic = (e) => {
        e.preventDefault();
        if (!newOptionalTopic.topic.trim()) return;
        const newEntry = {
          id: 'opt_' + Date.now(),
          paper: newOptionalTopic.paper,
